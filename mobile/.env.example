# Required for accounts and cloud fitness storage. The publishable key is safe
# to include in the app; never put a service_role secret in an EXPO_PUBLIC var.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional legacy API used only for online AI features. Use your computer's LAN
# address when testing that API on a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
