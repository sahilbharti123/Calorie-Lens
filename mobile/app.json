{
  "expo": {
    "name": "Vigorly",
    "slug": "vigorly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vigorly",
    "newArchEnabled": true,
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07090A",
    "primaryColor": "#C6FF3C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.advaice.calorielens",
      "buildNumber": "15",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSPhotoLibraryUsageDescription": "Vigorly does not read your photo library. iOS requires this notice because a bundled framework links the photo APIs.",
        "NSPhotoLibraryAddUsageDescription": "Vigorly does not save anything to your photo library. Backups are written as files you choose a location for.",
        "NSSpeechRecognitionUsageDescription": "Vigorly uses Apple speech recognition while you dictate a food or workout entry. Processing may use an installed offline language pack or Apple’s speech service.",
        "NSMicrophoneUsageDescription": "Vigorly uses the microphone only while you are dictating a food or workout entry."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.advaice.calorielens",
      "versionCode": 2,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_SLEEP",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#07090A",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 168,
          "resizeMode": "contain",
          "backgroundColor": "#07090A",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#07090A"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Vigorly uses the microphone only while you are dictating a food or workout entry.",
          "speechRecognitionPermission": "Vigorly uses operating-system speech recognition while you dictate a food or workout entry. Processing may use an installed offline language pack or the operating system’s speech service."
        }
      ],
      "expo-sqlite",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Vigorly reads steps, heart rate, active energy, workouts, sleep, and weight to show live workout progress and keep your fitness dashboard current.",
          "NSHealthUpdateUsageDescription": "Vigorly saves workouts and fitness information that you explicitly start or confirm on iPhone or Apple Watch.",
          "background": true
        }
      ],
      "expo-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e90be1b1-ccef-45bb-a981-b2aeb8b62aab"
      }
    },
    "owner": "sahilbhartis-team"
  }
}
