# Required for voice transcription and the AI coach.
GOOGLE_API_KEY=your_google_ai_key
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite

# Hard per-account UTC-day ceilings. Cached requests do not count.
CALORIE_LENS_AI_DAILY_LIMIT=8
CALORIE_LENS_AI_TEXT_DAILY_LIMIT=4
CALORIE_LENS_AI_AUDIO_DAILY_LIMIT=4
CALORIE_LENS_AI_COACH_DAILY_LIMIT=2

# The public Streamlit companion never uses paid AI unless this is explicitly enabled.
CALORIE_LENS_ENABLE_WEB_AI=false

# Persistent account database and AES-256 vault key.
CALORIE_LENS_DB_PATH=data/calorie_lens.db
CALORIE_LENS_KEY_PATH=data/calorie_lens.master.key

# Production: use a stable URL-safe base64 key that decodes to exactly 32 bytes.
# Generate one with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# CALORIE_LENS_MASTER_KEY=

# Comma-separated browser origins. Native apps are not restricted by CORS.
CALORIE_LENS_ALLOWED_ORIGINS=*
